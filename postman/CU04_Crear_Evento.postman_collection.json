  "item": [
    {
      "name": "1. Organizador publica nuevo Evento con múltiples tipos de entrada",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_organizador}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/eventos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "eventos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Festival Rock Ticket It 2026\",\n  \"descripcion\": \"El festival de música más esperado del año con artistas nacionales e internacionales.\",\n  \"categoriaId\": \"{{categoriaId}}\",\n  \"fecha\": \"2026-12-15T20:00:00.000Z\",\n  \"tiposEntrada\": [\n    {\n      \"nombre\": \"General\",\n      \"descripcion\": \"Acceso campo general\",\n      \"precio\": 5000,\n      \"cupo\": 100\n    },\n    {\n      \"nombre\": \"Platea\",\n      \"descripcion\": \"Ubicación preferencial con butaca\",\n      \"precio\": 12000,\n      \"cupo\": 30\n    },\n    {\n      \"nombre\": \"VIP Experience\",\n      \"descripcion\": \"Acceso VIP, consumición y catering\",\n      \"precio\": 25000,\n      \"cupo\": 10\n    }\n  ],\n  \"multimedia\": [\n    \"https://ticketit.com/images/festival2026.jpg\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 201 Created\", () => {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Evento creado correctamente y guarda IDs para pruebas posteriores\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.have.property('id');",
              "    pm.collectionVariables.set(\"eventoId\", data.id);",
              "    pm.expect(data.tiposEntrada).to.be.an('array').with.lengthOf(3);",
              "    pm.collectionVariables.set(\"tipoEntradaGeneralId\", data.tiposEntrada[0].id);",
              "    pm.collectionVariables.set(\"tipoEntradaPlateaId\", data.tiposEntrada[1].id);",
              "    pm.collectionVariables.set(\"tipoEntradaVipId\", data.tiposEntrada[2].id);",
              "    pm.collectionVariables.set(\"tipoEntradaId\", data.tiposEntrada[0].id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Error de validación - Tipos de entrada con precio o cupo <= 0 (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_organizador}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/eventos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "eventos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Evento Inválido\",\n  \"descripcion\": \"Prueba con cupo negativo\",\n  \"categoriaId\": \"{{categoriaId}}\",\n  \"fecha\": \"2026-12-15T20:00:00.000Z\",\n  \"tiposEntrada\": [\n    {\n      \"nombre\": \"General\",\n      \"precio\": -500,\n      \"cupo\": 0\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 400 Bad Request\", () => {",
              "    pm.response.to.have.status(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Seguridad - Comprador intenta crear un evento (403)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_comprador}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/eventos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "eventos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Evento No Autorizado\",\n  \"descripcion\": \"Debería ser rechazado\",\n  \"categoriaId\": \"{{categoriaId}}\",\n  \"fecha\": \"2026-12-15T20:00:00.000Z\",\n  \"tiposEntrada\": [\n    {\n      \"nombre\": \"General\",\n      \"precio\": 1000,\n      \"cupo\": 10\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 403 Forbidden\", () => {",
              "    pm.response.to.have.status(403);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
