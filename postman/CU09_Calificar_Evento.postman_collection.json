  "item": [
    {
      "name": "1. Regla de negocio - Comprador intenta reseñar SIN entrada utilizada (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_comprador}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/resenias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "resenias"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventoId\": \"{{eventoId}}\",\n  \"puntuacion\": 5,\n  \"detalle\": \"Quiero opinar antes de asistir\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 409 Conflict (no tiene compra UTILIZADA)\", () => {",
              "    pm.response.to.have.status(409);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Organizador registra ingreso y marca compra como UTILIZADA",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_organizador}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/compras/{{compraId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "compras",
            "{{compraId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"UTILIZADA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 200 OK\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Estado de compra cambia a UTILIZADA\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(data.estado).to.equal('UTILIZADA');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Comprador califica el evento con puntuación y comentario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_comprador}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/resenias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "resenias"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventoId\": \"{{eventoId}}\",\n  \"puntuacion\": 5,\n  \"detalle\": \"Excelente organización, sonido impecable y acceso rápido!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 201 Created\", () => {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Reseña creada y asociada correctamente\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.have.property('id');",
              "    pm.expect(data.puntuacion).to.equal(5);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Conflicto - Intento de duplicar reseña para el mismo evento (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_comprador}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/resenias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "resenias"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventoId\": \"{{eventoId}}\",\n  \"puntuacion\": 4,\n  \"detalle\": \"Segunda opinión no permitida\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 409 Conflict\", () => {",
              "    pm.response.to.have.status(409);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Error de validación - Puntuación fuera de rango numérico (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_comprador}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/resenias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "resenias"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventoId\": \"{{eventoId}}\",\n  \"puntuacion\": 10,\n  \"detalle\": \"Puntaje inválido\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 400 Bad Request\", () => {",
              "    pm.response.to.have.status(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}