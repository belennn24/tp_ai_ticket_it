  "item": [
    {
      "name": "1. Conflicto - Intento de cancelar compra ya cancelada (409)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_comprador}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/compras/{{compra2Id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "compras",
            "{{compra2Id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"CANCELADA\",\n  \"motivo\": \"Reintento inválido\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 409 Conflict\", () => {",
              "    pm.response.to.have.status(409);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
