  "item": [
    {
      "name": "1. Registro de nuevo usuario comprador (POST /api/auth/registro)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/registro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "registro"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Lucia\",\n  \"apellido\": \"Ventas\",\n  \"email\": \"lucia.compradora@ticketit.com\",\n  \"password\": \"Password123!\",\n  \"rol\": \"comprador\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 201 Created\", () => {",
              "    pm.response.to.have.status(201);",
              "});",
              "var data = pm.response.json();",
              "pm.expect(data.token).to.be.a('string');",
              "pm.expect(data.usuario.email).to.equal('lucia.compradora@ticketit.com');",
              "pm.collectionVariables.set(\"token_lucia\", data.token);",
              ""
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Login con credenciales válidas (POST /api/auth/login)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"lucia.compradora@ticketit.com\",\n  \"password\": \"Password123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 200 OK\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "var data = pm.response.json();",
              "pm.expect(data.token).to.be.a('string');",
              "pm.collectionVariables.set(\"token_lucia\", data.token);",
              ""
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Login fallido por contraseña incorrecta (401 Unauthorized)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"lucia.compradora@ticketit.com\",\n  \"password\": \"PasswordErronea\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 401 Unauthorized\", () => {",
              "    pm.response.to.have.status(401);",
              "});",
              ""
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Consultar perfil del usuario autenticado (GET /api/auth/me)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_lucia}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 200 OK\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "var data = pm.response.json();",
              "pm.expect(data.user || data.usuario).to.be.an('object');",
              ""
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
