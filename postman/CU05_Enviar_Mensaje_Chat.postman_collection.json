              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 403 Forbidden para usuario ajeno a la compra\", () => {",
              "    pm.response.to.have.status(403);",
              "});"
            ],
