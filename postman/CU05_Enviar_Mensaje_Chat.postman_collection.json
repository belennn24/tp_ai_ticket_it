            "{{compraId}}",
            "mensajes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mensaje\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 400 Bad Request\", () => {",
              "    pm.response.to.have.status(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Seguridad - Usuario ajeno a la compra intenta enviar mensaje (403)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_comprador_2}}",
            "type": "text"
