        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 404 Not Found\", () => {",
              "    pm.response.to.have.status(404);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
