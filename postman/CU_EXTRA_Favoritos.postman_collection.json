  "item": [
    {
      "name": "1. Comprador agrega evento a su lista de Favoritos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_comprador}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/usuarios/me/favoritos/{{eventoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "usuarios",
            "me",
            "favoritos",
            "{{eventoId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 200 OK\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Evento agregado con éxito\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(data.favoritos).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Conflicto - Intento de agregar nuevamente el mismo evento a favoritos (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_comprador}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/usuarios/me/favoritos/{{eventoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "usuarios",
            "me",
            "favoritos",
            "{{eventoId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 409 Conflict (ya es favorito)\", () => {",
              "    pm.response.to.have.status(409);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Comprador consulta sus eventos Favoritos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_comprador}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/usuarios/me/favoritos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "usuarios",
            "me",
            "favoritos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Lista contiene el evento guardado\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(Array.isArray(data)).to.be.true;",
              "    pm.expect(data.some(e => e.id === pm.collectionVariables.get(\"eventoId\"))).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Comprador elimina el evento de sus Favoritos",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_comprador}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/usuarios/me/favoritos/{{eventoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "usuarios",
            "me",
            "favoritos",
            "{{eventoId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 200 OK\", () => {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Error - Intentar eliminar un evento que ya no está en favoritos (404)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_comprador}}",
            "type": "text"
