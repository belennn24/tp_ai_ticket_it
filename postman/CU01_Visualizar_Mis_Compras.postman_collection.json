          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 403 Forbidden para rol organizador\", () => {",
              "    pm.response.to.have.status(403);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
