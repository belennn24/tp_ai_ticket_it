  "item": [
    {
      "name": "1. Listar categorías del catálogo (Público)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/categorias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categorias"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Organizador/Admin crea nueva Categoría",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_organizador}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/categorias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categorias"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Festivales al Aire Libre\",\n  \"descripcion\": \"Eventos masivos y festivales en espacios abiertos\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 201 Created\", () => {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Categoría creada con ID único\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.have.property('id');",
              "    pm.collectionVariables.set(\"categoriaId\", data.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Conflicto - Intento de crear categoría con nombre existente (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_organizador}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/categorias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categorias"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Festivales al Aire Libre\",\n  \"descripcion\": \"Intento duplicado\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 409 Conflict\", () => {",
              "    pm.response.to.have.status(409);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
