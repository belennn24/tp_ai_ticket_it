  "item": [
    {
      "name": "1. Comprador adquiere entradas válidas dentro del cupo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_comprador}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/compras",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "compras"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventoId\": \"{{eventoId}}\",\n  \"tipoEntradaId\": \"{{tipoEntradaGeneralId}}\",\n  \"cantidad\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 201 Created\", () => {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Compra creada en estado CONFIRMADA y descuenta cupo\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.have.property('id');",
              "    pm.expect(data.estado).to.equal('CONFIRMADA');",
              "    pm.expect(data.cantidad).to.equal(2);",
              "    pm.expect(data.total).to.equal(10000); // 2 * 5000",
              "    pm.collectionVariables.set(\"compraId\", data.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Conflicto - Intentar comprar superando el cupo disponible (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_comprador}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/compras",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "compras"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventoId\": \"{{eventoId}}\",\n  \"tipoEntradaId\": \"{{tipoEntradaGeneralId}}\",\n  \"cantidad\": 999999\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 409 Conflict por cupo insuficiente\", () => {",
              "    pm.response.to.have.status(409);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
