  "item": [
    {
      "name": "1. Explorar catálogo general de categorías",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/categorias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categorias"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Retorna array de categorías disponibles\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(Array.isArray(data)).to.be.true;",
              "    if (data.length > 0) {",
              "        pm.collectionVariables.set(\"categoriaId\", data[0].id);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Buscar eventos por coincidencia textual",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/eventos?texto=Rock",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "eventos"
          ],
          "query": [
            {
              "key": "texto",
              "value": "Rock",
              "description": ""
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Retorna eventos coincidentes con el texto buscado\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(Array.isArray(data)).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Filtrar eventos por Categoría",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/eventos?categoriaId={{categoriaId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "eventos"
          ],
          "query": [
            {
              "key": "categoriaId",
              "value": "{{categoriaId}}",
              "description": ""
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Retorna eventos correspondientes a la categoría\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(Array.isArray(data)).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Búsqueda combinada (texto + rango de precios)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/eventos?texto=Rock&precioMin=1000&precioMax=50000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "eventos"
          ],
          "query": [
            {
              "key": "texto",
              "value": "Rock",
              "description": ""
            },
            {
              "key": "precioMin",
              "value": "1000",
              "description": ""
            },
            {
              "key": "precioMax",
              "value": "50000",
              "description": ""
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Filtra con éxito por rango de precios\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(Array.isArray(data)).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Ver detalle completo de un evento por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/eventos/{{eventoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "eventos",
            "{{eventoId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Retorna detalle completo con tipos de entrada y cupos\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.have.property('id');",
              "    pm.expect(data).to.have.property('tiposEntrada');",
              "    pm.expect(Array.isArray(data.tiposEntrada)).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. Error de validación - precioMin mayor a precioMax (400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/eventos?precioMin=50000&precioMax=1000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "eventos"
          ],
          "query": [
            {
              "key": "precioMin",
              "value": "50000",
              "description": ""
            },
            {
              "key": "precioMax",
              "value": "1000",
              "description": ""
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 400 Bad Request\", () => {",
              "    pm.response.to.have.status(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}