  "item": [
    {
      "name": "1. Organizador responde mensaje del comprador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_organizador}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/compras/{{compraId}}/mensajes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "compras",
            "{{compraId}}",
            "mensajes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mensaje\": \"Hola Juan, las puertas abrirán a las 18:00 hs. Habrá control de acceso en la entrada norte.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 201 Created\", () => {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Respuesta del organizador guardada correctamente\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.have.property('mensaje');",
              "    pm.expect(data.mensaje).to.include('18:00 hs');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Organizador lee todos los mensajes de la compra",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_organizador}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/compras/{{compraId}}/mensajes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "compras",
            "{{compraId}}",
            "mensajes"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code es 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Historial contiene la conversación completa entre comprador y organizador\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(Array.isArray(data)).to.be.true;",
              "    pm.expect(data.length).to.be.at.least(2);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
